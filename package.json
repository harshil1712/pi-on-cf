{
  "name": "pi-on-cf",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.3",
    "@cloudflare/computer": "0.4.1",
    "@cloudflare/kumo": "^2.14.0",
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-durable": "^1.0.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.4.0",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "agents": "^0.26.0",
    "ai": "^7.0.130",
    "just-bash": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@octokit/openapi-types": "^29.0.1",
    "@octokit/openapi-webhooks-types": "^12.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "@google/genai": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "fsevents": false,
    "node-liblzma": false,
    "protobufjs": false
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": "5.20261001.0-alpha",
      "wrangler": "$wrangler"
    }
  }
}
