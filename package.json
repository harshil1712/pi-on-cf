{
  "name": "pi-on-cf",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.5",
    "@cloudflare/computer": "0.8.0",
    "@cloudflare/kumo": "^2.16.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.4.1",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "agents": "^0.31.0",
    "ai": "^7.0.154",
    "just-bash": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@earendil-works/chord": "~1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@octokit/openapi-types": "^29.0.1",
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "@google/genai": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "fsevents": false,
    "node-liblzma": false,
    "protobufjs": false
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "miniflare": "5.20261023.0-beta",
      "wrangler": "$wrangler"
    }
  }
}
