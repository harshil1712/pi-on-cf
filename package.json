{
  "name": "pi-on-cf",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.6",
    "@cloudflare/computer": "0.10.0",
    "@cloudflare/kumo": "^2.17.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-durable": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@platformatic/vfs": "^0.5.0",
    "@streamdown/code": "^2.0.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "agents": "^0.33.0",
    "ai": "^7.0.163",
    "just-bash": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@earendil-works/chord": "~1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@octokit/openapi-types": "^29.0.1",
    "@oxlint/plugins": "1.92.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "@google/genai": false,
    "@mongodb-js/zstd": false,
    "core-js-pure": false,
    "fsevents": false,
    "node-liblzma": false,
    "protobufjs": false
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "wrangler": "$wrangler"
    },
    "guarded-fetch": {
      "undici": "7.30.1"
    }
  }
}
