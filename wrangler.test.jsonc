{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-on-cf-test",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server-test-entry.ts",
  "vars": {
    "AI_GATEWAY_ID": "test",
    "AI_MODEL": "@cf/zai-org/glm-5.2",
    "AI_MEMORY_MODEL": "@cf/zai-org/glm-5.2"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PiSession", "class_name": "PiSession" },
      { "name": "PiRegistry", "class_name": "PiRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PiRegistry"] }
  ],
  "worker_loaders": [
    { "binding": "APP_LOADER" }
  ]
}
