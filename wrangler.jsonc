/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-on-cf",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "main": "src/server.ts",
  "vars": {
    "AI_GATEWAY_ID": "default",
    "AI_MODEL": "@cf/zai-org/glm-5.2",
  },
  // Workers AI and AI Gateway for pi, through agents/models/pi-ai.
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiSession",
        "class_name": "PiSession",
      },
      {
        "name": "PiRegistry",
        "class_name": "PiRegistry",
      },
    ],
  },
  // Each PiSession schedules its own Computer container. The image key is
  // the ContainerBackend's `name`; the instance size is requested at launch.
  "containers": [
    {
      "class_name": "PiSession",
      "scheduling_policy": "durable_object",
      "images": {
        "computer": { "dockerfile": "./Dockerfile.computer" },
      },
      "observability": { "enabled": true },
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiSession"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PiRegistry"],
    },
  ],
  // The app's one R2 bucket. Agent Skills live under `skills/`.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pi-on-cf",
      "remote": true,
    },
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "pi-apps",
      "remote": true,
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "upload_source_maps": true,
}
