/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-on-cf",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "main": "src/server.ts",
  "vars": {
    "AI_GATEWAY_ID": "default",
    "AI_MODEL": "@cf/zai-org/glm-5.3",
    // Web search, off by default: set both to install pi's web_search tool,
    // after storing the provider's key on the AI Gateway ("Web search" in
    // the README). "WEB_SEARCH_PROVIDER": "exa",
    // "WEB_SEARCH_BYOK_ALIAS": "pi-search",
  },
  // The GitHub App sessions clone, push and open pull requests as, and the
  // secret its webhooks are signed with; see "GitHub App" in the README. Only
  // the private key and webhook secret are sensitive, but every value is per
  // deployment, and declaring them here makes `wrangler deploy` refuse to
  // run until each is set. Set them with `wrangler secret put`, or in
  // `.dev.vars` locally.
  "secrets": {
    "required": ["GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY", "GITHUB_APP_SLUG", "GITHUB_APP_BOT_ID", "GITHUB_OWNERS", "GITHUB_WEBHOOK_SECRET"],
  },
  // Workers AI and AI Gateway for pi, through agents/models/pi-ai.
  "ai": {
    "binding": "AI",
  },
  // Browser Run for pi's browser tool.
  "browser": {
    "binding": "BROWSER",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiSession",
        "class_name": "PiSession",
      },
      {
        "name": "PiRegistry",
        "class_name": "PiRegistry",
      },
    ],
  },
  // Each PiSession schedules its own Computer container. The image key is
  // the ContainerBackend's `name`; the instance size is requested at launch.
  "containers": [
    {
      "class_name": "PiSession",
      "scheduling_policy": "durable_object",
      "images": {
        "computer": { "dockerfile": "./container/Dockerfile" },
      },
      "observability": { "enabled": true },
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiSession"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PiRegistry"],
    },
  ],
  // The app's one R2 bucket. Agent Skills live under `skills/`.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pi-on-cf",
      "remote": true,
    },
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "pi-apps",
      "remote": true,
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "upload_source_maps": true,
  // Serve Worker Previews (and version preview URLs) on workers.dev. Preview
  // URLs are public; put them behind Cloudflare Access like production.
  "preview_urls": true,
  // Worker Previews (`npx wrangler preview`) inherit none of the bindings,
  // vars or secrets above, so they are repeated here. Each Preview gets its
  // own Durable Object namespaces; R2 and Artifacts point at separate preview
  // resources so branches never touch production data. Set the GitHub App
  // secrets for new Previews with
  // `npx wrangler preview base-config secret put <NAME>`.
  // Previews do not support Durable Object-scheduled containers yet, so the
  // Computer container is unavailable in a Preview.
  "previews": {
    "vars": {
      "AI_GATEWAY_ID": "default",
      "AI_MODEL": "@cf/zai-org/glm-5.3",
    },
    "ai": {
      "binding": "AI",
    },
    "browser": {
      "binding": "BROWSER",
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "PiSession",
          "class_name": "PiSession",
        },
        {
          "name": "PiRegistry",
          "class_name": "PiRegistry",
        },
      ],
    },
    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "pi-on-cf-preview",
      },
    ],
    "artifacts": [
      {
        "binding": "ARTIFACTS",
        "namespace": "pi-apps-preview",
      },
    ],
    "worker_loaders": [
      {
        "binding": "LOADER",
      },
    ],
  },
}
